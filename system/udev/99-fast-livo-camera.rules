# Stable identities for the original Global Shutter RGB camera.
# The Gemini 335L is intentionally excluded, regardless of /dev/videoN order.
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="32e4", ATTRS{idProduct}=="05b1", ATTR{index}=="0", SYMLINK+="fast_livo_camera", MODE="0666"
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="32e4", ATTRS{idProduct}=="05b1", ATTR{index}=="1", SYMLINK+="fast_livo_camera_metadata", MODE="0666"
